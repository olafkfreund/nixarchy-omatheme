#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from pathlib import Path


LIB = Path(__file__).resolve().parent
PALETTE = LIB / "hyprchroma-palette"
STATE = LIB / "hyprchroma-state"
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
RUNTIME_DIR = CONFIG_HOME / "omarchy/runtime"
NVIM_THEME = RUNTIME_DIR / "neovim-theme.lua"
VIM_THEME = RUNTIME_DIR / "vim-theme.vim"
STATUS_FILE = STATE_HOME / "hyprchroma/editors.json"
HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")

GROUPS = {
    "Normal": ("foreground", "background"),
    "NormalFloat": ("foreground", "dark_background"),
    "CursorLine": (None, "lighter_background"),
    "CursorLineNr": ("accent", "lighter_background"),
    "LineNr": ("muted", "background"),
    "SignColumn": ("muted", "background"),
    "Visual": ("foreground", "selection"),
    "Search": ("background", "yellow"),
    "IncSearch": ("background", "accent"),
    "StatusLine": ("foreground", "lighter_background"),
    "StatusLineNC": ("muted", "dark_background"),
    "WinSeparator": ("muted", "background"),
    "Pmenu": ("foreground", "dark_background"),
    "PmenuSel": ("background", "accent"),
    "Comment": ("muted", None),
    "Constant": ("magenta", None),
    "String": ("green", None),
    "Character": ("green", None),
    "Number": ("yellow", None),
    "Boolean": ("yellow", None),
    "Identifier": ("foreground", None),
    "Function": ("blue", None),
    "Statement": ("red", None),
    "Conditional": ("red", None),
    "Repeat": ("red", None),
    "Operator": ("accent", None),
    "Keyword": ("red", None),
    "Type": ("yellow", None),
    "Special": ("cyan", None),
    "Error": ("bright_red", None),
    "Todo": ("background", "yellow"),
    "VertSplit": ("muted", "background"),
    "DiffAdd": ("background", "green"),
    "DiffChange": ("background", "blue"),
    "DiffDelete": ("background", "red"),
    "DiffText": ("background", "yellow"),
    "DiagnosticError": ("red", None),
    "DiagnosticWarn": ("yellow", None),
    "DiagnosticInfo": ("blue", None),
    "DiagnosticHint": ("cyan", None),
}

# Neovim-only: capture links and groups using @-names, sp or undercurl.
NVIM_LINKS = {
    "@comment": "Comment", "@string": "String", "@character": "Character",
    "@number": "Number", "@boolean": "Boolean", "@constant": "Constant",
    "@function": "Function", "@function.call": "Function", "@method": "Function",
    "@keyword": "Keyword", "@conditional": "Conditional", "@repeat": "Repeat",
    "@operator": "Operator", "@type": "Type", "@variable": "Identifier",
    "@property": "Identifier", "@punctuation": "Special", "@tag": "Statement",
    "@lsp.type.function": "Function", "@lsp.type.variable": "Identifier",
    "@lsp.type.type": "Type", "@lsp.type.keyword": "Keyword",
}
SEVERITY = {"Error": "red", "Warn": "yellow", "Info": "blue", "Hint": "cyan"}
NVIM_COLORS = {"FloatBorder": {"fg": "muted", "bg": "dark_background"}}
for _level, _color in SEVERITY.items():
    NVIM_COLORS[f"DiagnosticVirtualText{_level}"] = {"fg": _color, "bg": "dark_background"}
    NVIM_COLORS[f"DiagnosticUnderline{_level}"] = {"sp": _color, "undercurl": True}
NVIM_COLORS.update({
    "GitSignsAdd": {"fg": "green"},
    "GitSignsChange": {"fg": "yellow"},
    "GitSignsDelete": {"fg": "red"},
})


def read_palette() -> tuple[dict[str, str], str]:
    colors: dict[str, str] = {}
    mode = "dark"
    result = subprocess.run([str(PALETTE), "--all"], check=True, text=True, capture_output=True)
    for line in result.stdout.splitlines():
        key, _, value = line.partition("\t")
        if key == "mode" and value in {"dark", "light"}:
            mode = value
            continue
        if HEX.fullmatch(value):
            colors[key] = value.lower()
    required = {"background", "foreground", "accent", "muted", "red", "green", "yellow", "blue", "magenta"}
    missing = required - colors.keys()
    if missing:
        raise ValueError(f"missing palette values: {', '.join(sorted(missing))}")
    colors.setdefault("dark_background", colors["background"])
    colors.setdefault("lighter_background", colors["background"])
    colors.setdefault("selection", colors["accent"])
    colors.setdefault("bright_foreground", colors["foreground"])
    colors.setdefault("bright_red", colors["red"])
    colors.setdefault("cyan", colors["blue"])
    return colors, mode


def write_file(path: Path, content: str) -> None:
    subprocess.run(
        [str(STATE), "write-file", "--path", str(path), "--mode", "644"],
        input=content,
        text=True,
        check=True,
    )


def lua_string(value: str) -> str:
    return json.dumps(value)


def render_neovim(colors: dict[str, str], mode: str) -> str:
    lines = [
        "-- Generated by hyprchroma; do not edit.",
        "return {",
        f"  mode = {lua_string(mode)},",
        "  colors = {",
    ]
    lines.extend(f"    {name} = {lua_string(colors[name])}," for name in sorted(colors))
    lines.extend(["  },", "  highlights = {"])
    entries = {
        group: {"fg": fg, "bg": bg} for group, (fg, bg) in GROUPS.items()
    }
    entries.update(NVIM_COLORS)
    for group, attrs in entries.items():
        values = []
        for key in ("fg", "bg", "sp"):
            if attrs.get(key):
                values.append(f"{key} = {lua_string(colors[attrs[key]])}")
        if attrs.get("undercurl"):
            values.append("undercurl = true")
        lines.append(f"    [{lua_string(group)}] = {{ {', '.join(values)} }},")
    for group, target in NVIM_LINKS.items():
        lines.append(f"    [{lua_string(group)}] = {{ link = {lua_string(target)} }},")
    lines.extend(["  },", "}", ""])
    return "\n".join(lines)


def render_vim(colors: dict[str, str], mode: str) -> str:
    lines = [
        '" Generated by hyprchroma; do not edit.',
        "\" Only gui colours are written: keep the user's colours where they cannot show.",
        "if !has('gui_running') && !&termguicolors && !(has('termguicolors') && $COLORTERM =~# 'truecolor\\|24bit') | finish | endif",
        "unlet! g:colors_name",
        f"set background={mode}",
        "highlight clear",
        "if exists('syntax_on') | syntax reset | endif",
        "let g:colors_name = 'omarchy'",
        "if has('termguicolors') && $COLORTERM =~# 'truecolor\\|24bit' | set termguicolors | endif",
    ]
    for group, (foreground, background) in GROUPS.items():
        values = []
        if foreground:
            values.append(f"guifg={colors[foreground]}")
        if background:
            values.append(f"guibg={colors[background]}")
        lines.append(f"highlight {group} {' '.join(values)}")
    return "\n".join(lines) + "\n"


def main() -> int:
    try:
        colors, mode = read_palette()
        write_file(NVIM_THEME, render_neovim(colors, mode))
        write_file(VIM_THEME, render_vim(colors, mode))
        write_file(STATUS_FILE, json.dumps({"neovim": "generated", "vim": "generated"}, indent=2) + "\n")
        print("hyprchroma-editors: editor colors generated")
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        write_file(STATUS_FILE, json.dumps({"neovim": "unavailable", "vim": "unavailable"}, indent=2) + "\n")
        print(f"hyprchroma-editors: {error}", file=sys.stderr)
        return 1


raise SystemExit(main())
