#!/usr/bin/env bash
set -euo pipefail

HYPRCHROMA_LIB=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
RUNTIME_DIR="$CONFIG_HOME/omarchy/runtime"
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/hyprchroma

kitty_status="new-windows-only"
foot_status="restart-required"
ghostty_status="new-windows-only"

declare -A PALETTE
while IFS=$'\t' read -r key value; do
  [[ -n $key ]] && PALETTE[$key]=$value
done < <("$HYPRCHROMA_LIB/hyprchroma-palette" --all)

for key in background foreground darker_background bright_foreground selection selection_foreground accent red green yellow blue magenta bright_red bright_green bright_yellow; do
  value=${PALETTE[$key]:-}
  [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || {
    printf 'hyprchroma-terminals: invalid palette value for %s\n' "$key" >&2
    exit 1
  }
done

without_hash() {
  printf '%s' "${1#\#}"
}

write_runtime() {
  local name=$1
  "$HYPRCHROMA_LIB/hyprchroma-state" write-file \
    --path "$RUNTIME_DIR/$name" --mode 644
}

render_kitty() {
  cat <<EOF | write_runtime kitty.conf
# Generated by hyprchroma. Do not edit; change the Omarchy theme instead.
foreground ${PALETTE[foreground]}
background ${PALETTE[background]}
selection_foreground ${PALETTE[selection_foreground]}
selection_background ${PALETTE[selection]}
cursor ${PALETTE[accent]}
cursor_text_color ${PALETTE[background]}
color0 ${PALETTE[background]}
color1 ${PALETTE[red]}
color2 ${PALETTE[green]}
color3 ${PALETTE[yellow]}
color4 ${PALETTE[blue]}
color5 ${PALETTE[magenta]}
color6 ${PALETTE[blue]}
color7 ${PALETTE[foreground]}
color8 ${PALETTE[darker_background]}
color9 ${PALETTE[bright_red]}
color10 ${PALETTE[bright_green]}
color11 ${PALETTE[bright_yellow]}
color12 ${PALETTE[bright_blue]:-${PALETTE[blue]}}
color13 ${PALETTE[magenta]}
color14 ${PALETTE[blue]}
color15 ${PALETTE[bright_foreground]}
EOF
}

render_foot() {
  cat <<EOF | write_runtime foot.ini
# Generated by hyprchroma. Do not edit; change the Omarchy theme instead.
[colors]
background=$(without_hash "${PALETTE[background]}")
foreground=$(without_hash "${PALETTE[foreground]}")
selection-background=$(without_hash "${PALETTE[selection]}")
selection-foreground=$(without_hash "${PALETTE[selection_foreground]}")
cursor=$(without_hash "${PALETTE[accent]}") $(without_hash "${PALETTE[background]}")
regular0=$(without_hash "${PALETTE[background]}")
regular1=$(without_hash "${PALETTE[red]}")
regular2=$(without_hash "${PALETTE[green]}")
regular3=$(without_hash "${PALETTE[yellow]}")
regular4=$(without_hash "${PALETTE[blue]}")
regular5=$(without_hash "${PALETTE[magenta]}")
regular6=$(without_hash "${PALETTE[blue]}")
regular7=$(without_hash "${PALETTE[foreground]}")
bright0=$(without_hash "${PALETTE[darker_background]}")
bright1=$(without_hash "${PALETTE[bright_red]}")
bright2=$(without_hash "${PALETTE[bright_green]}")
bright3=$(without_hash "${PALETTE[bright_yellow]}")
bright4=$(without_hash "${PALETTE[blue]}")
bright5=$(without_hash "${PALETTE[magenta]}")
bright6=$(without_hash "${PALETTE[blue]}")
bright7=$(without_hash "${PALETTE[bright_foreground]}")
EOF
}

render_ghostty() {
  cat <<EOF | write_runtime ghostty.conf
# Generated by hyprchroma. Do not edit; change the Omarchy theme instead.
background = $(without_hash "${PALETTE[background]}")
foreground = $(without_hash "${PALETTE[foreground]}")
cursor-color = $(without_hash "${PALETTE[accent]}")
cursor-text = $(without_hash "${PALETTE[background]}")
selection-background = $(without_hash "${PALETTE[selection]}")
selection-foreground = $(without_hash "${PALETTE[selection_foreground]}")
palette = 0=$(without_hash "${PALETTE[background]}")
palette = 1=$(without_hash "${PALETTE[red]}")
palette = 2=$(without_hash "${PALETTE[green]}")
palette = 3=$(without_hash "${PALETTE[yellow]}")
palette = 4=$(without_hash "${PALETTE[blue]}")
palette = 5=$(without_hash "${PALETTE[magenta]}")
palette = 6=$(without_hash "${PALETTE[blue]}")
palette = 7=$(without_hash "${PALETTE[foreground]}")
palette = 8=$(without_hash "${PALETTE[darker_background]}")
palette = 9=$(without_hash "${PALETTE[bright_red]}")
palette = 10=$(without_hash "${PALETTE[bright_green]}")
palette = 11=$(without_hash "${PALETTE[bright_yellow]}")
palette = 12=$(without_hash "${PALETTE[blue]}")
palette = 13=$(without_hash "${PALETTE[magenta]}")
palette = 14=$(without_hash "${PALETTE[blue]}")
palette = 15=$(without_hash "${PALETTE[bright_foreground]}")
EOF
}

reload_kitty() {
  if command -v kitten >/dev/null 2>&1 && \
    kitten @ set-colors --all --configured "$RUNTIME_DIR/kitty.conf" >/dev/null 2>&1; then
    kitty_status="synchronized"
  fi
}

reload_ghostty() {
  if command -v systemctl >/dev/null 2>&1 && \
    systemctl --user is-active --quiet app-com.mitchellh.ghostty.service && \
    systemctl --user reload app-com.mitchellh.ghostty.service >/dev/null 2>&1; then
    ghostty_status="synchronized"
  fi
}

write_status() {
  cat <<EOF | "$HYPRCHROMA_LIB/hyprchroma-state" write-file \
    --path "$STATE_DIR/terminals.json" --mode 644
{
  "kitty": "$kitty_status",
  "foot": "$foot_status",
  "ghostty": "$ghostty_status"
}
EOF
}

case ${1:-all} in
  kitty)
    render_kitty
    reload_kitty
    write_status
    ;;
  foot)
    render_foot
    write_status
    ;;
  ghostty)
    render_ghostty
    reload_ghostty
    write_status
    ;;
  all)
    render_kitty
    render_foot
    render_ghostty
    reload_kitty
    reload_ghostty
    write_status
    ;;
  *)
    printf 'Usage: hyprchroma-terminals [kitty|foot|ghostty|all]\n' >&2
    exit 2
    ;;
esac
