#!/usr/bin/env python3
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


LIB = Path(__file__).resolve().parent
STATE = LIB / "hyprchroma-state"
PALETTE = LIB / "hyprchroma-palette"
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
RUNTIME_DIR = CONFIG_HOME / "omarchy/runtime"
STARSHIP_BASE = RUNTIME_DIR / "starship.base.toml"
STARSHIP_CONFIG = RUNTIME_DIR / "starship.toml"
SHELL_THEME = RUNTIME_DIR / "shell-theme.sh"
FISH_THEME = RUNTIME_DIR / "shell-theme.fish"
STATUS_FILE = STATE_HOME / "hyprchroma/shell.json"
HEX = re.compile(r"^#?[0-9A-Fa-f]{6,8}$")
BEGIN = "# hyprchroma: palette begin"
END = "# hyprchroma: palette end"


def read_palette() -> dict[str, str]:
    values = {}
    result = subprocess.run([str(PALETTE), "--all"], check=True, text=True, capture_output=True)
    for line in result.stdout.splitlines():
        key, _, value = line.partition("\t")
        if key and HEX.fullmatch(value):
            values[key] = "#" + value.lstrip("#")
    required = {"background", "foreground", "accent", "muted", "red", "green", "yellow", "blue"}
    missing = required - values.keys()
    if missing:
        raise ValueError(f"missing palette values: {', '.join(sorted(missing))}")
    return values


def write_file(path: Path, content: str) -> None:
    subprocess.run(
        [str(STATE), "write-file", "--path", str(path), "--mode", "644"],
        input=content,
        text=True,
        check=True,
    )


def write_status(status: dict[str, str]) -> None:
    write_file(STATUS_FILE, json.dumps(status, indent=2, sort_keys=True) + "\n")


def starship_base() -> str | None:
    if STARSHIP_BASE.exists():
        if STARSHIP_BASE.is_symlink():
            return None
        return STARSHIP_BASE.read_text(encoding="utf-8")
    source = CONFIG_HOME / "starship.toml"
    if source.is_symlink():
        return None
    if source.exists():
        return source.read_text(encoding="utf-8")
    return "format = \"$character\"\n"


def render_starship(colors: dict[str, str]) -> str | None:
    if shutil.which("starship") is None:
        return None
    base = starship_base()
    if base is None:
        return None
    base = re.sub(rf"(?ms)^{re.escape(BEGIN)}.*?^{re.escape(END)}\n?", "", base)
    base = re.sub(r"(?m)^palette\s*=.*\n?", "", base)
    palette = {
        "color_fg0": colors["foreground"],
        "color_bg0": colors["background"],
        "color_bg1": colors.get("dark_background", colors["background"]),
        "color_bg3": colors["muted"],
        "color_blue": colors["blue"],
        "color_aqua": colors.get("cyan", colors["blue"]),
        "color_green": colors["green"],
        "color_orange": colors.get("orange", colors["accent"]),
        "color_purple": colors.get("purple", colors["accent"]),
        "color_red": colors["red"],
        "color_yellow": colors["yellow"],
    }
    block = [BEGIN, 'palette = "hyprchroma"', "", "[palettes.hyprchroma]"]
    block.extend(f"{key} = \"{value}\"" for key, value in palette.items())
    block.append(END)
    return "\n".join(block) + "\n\n" + base.lstrip()


def render_shell_theme(colors: dict[str, str]) -> str:
    exports = {
        "HYPRCHROMA_COLOR_BACKGROUND": colors["background"],
        "HYPRCHROMA_COLOR_FOREGROUND": colors["foreground"],
        "HYPRCHROMA_COLOR_ACCENT": colors["accent"],
        "HYPRCHROMA_COLOR_MUTED": colors["muted"],
        "HYPRCHROMA_COLOR_RED": colors["red"],
        "HYPRCHROMA_COLOR_GREEN": colors["green"],
        "HYPRCHROMA_COLOR_YELLOW": colors["yellow"],
        "HYPRCHROMA_COLOR_BLUE": colors["blue"],
        "STARSHIP_CONFIG": str(STARSHIP_CONFIG),
    }
    lines = ["# Generated by hyprchroma; do not edit."]
    lines.extend(f"export {key}={value!r}" for key, value in exports.items())
    return "\n".join(lines) + "\n"


def render_fish_theme(colors: dict[str, str]) -> str:
    exports = {
        "HYPRCHROMA_COLOR_BACKGROUND": colors["background"],
        "HYPRCHROMA_COLOR_FOREGROUND": colors["foreground"],
        "HYPRCHROMA_COLOR_ACCENT": colors["accent"],
        "HYPRCHROMA_COLOR_MUTED": colors["muted"],
        "HYPRCHROMA_COLOR_RED": colors["red"],
        "HYPRCHROMA_COLOR_GREEN": colors["green"],
        "HYPRCHROMA_COLOR_YELLOW": colors["yellow"],
        "HYPRCHROMA_COLOR_BLUE": colors["blue"],
        "STARSHIP_CONFIG": str(STARSHIP_CONFIG),
    }
    lines = ["# Generated by hyprchroma; do not edit."]
    lines.extend(f"set -gx {key} '{value}'" for key, value in exports.items())
    return "\n".join(lines) + "\n"


def main() -> int:
    try:
        colors = read_palette()
        starship = render_starship(colors)
        if starship is not None:
            write_file(STARSHIP_CONFIG, starship)
            starship_status = "prompt-refresh"
        else:
            starship_status = "unavailable"
        write_file(SHELL_THEME, render_shell_theme(colors))
        write_file(FISH_THEME, render_fish_theme(colors))
        status = {
            "starship": starship_status,
            "bash": "prompt-refresh" if shutil.which("bash") else "unavailable",
            "zsh": "prompt-refresh" if shutil.which("zsh") else "unavailable",
            "fish": "prompt-refresh" if shutil.which("fish") else "unavailable",
        }
        write_status(status)
        print("hyprchroma-shell: shell colors synchronized")
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        write_status({name: "unavailable" for name in ("starship", "bash", "zsh", "fish")})
        print(f"hyprchroma-shell: {error}", file=sys.stderr)
        return 1


raise SystemExit(main())
