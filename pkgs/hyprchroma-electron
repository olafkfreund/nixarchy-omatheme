#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path


LIB = Path(__file__).resolve().parent
STATE = LIB / "hyprchroma-state"
PALETTE = LIB / "hyprchroma-palette"
STATE_FILE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hyprchroma/electron.json"
REGISTRY = {
    "vscode": "supported",
    "discord": "unsupported",
}
GENERATED = {
    "editor.background",
    "editor.foreground",
    "editor.selectionBackground",
    "editorCursor.foreground",
    "editorLineNumber.foreground",
    "editorLineNumber.activeForeground",
    "activityBar.background",
    "sideBar.background",
    "titleBar.activeBackground",
    "statusBar.background",
    "button.background",
    "focusBorder",
    "terminal.ansiBlack",
    "terminal.ansiRed",
    "terminal.ansiGreen",
    "terminal.ansiYellow",
    "terminal.ansiBlue",
    "terminal.ansiMagenta",
    "terminal.ansiCyan",
    "terminal.ansiWhite",
}


def palette() -> dict[str, str]:
    values = {}
    result = subprocess.run([str(PALETTE), "--all"], check=True, text=True, capture_output=True)
    for line in result.stdout.splitlines():
        key, _, value = line.partition("\t")
        if key:
            values[key] = value
    return values


def write_json(path: Path, value: dict) -> None:
    subprocess.run(
        [str(STATE), "write-file", "--path", str(path), "--mode", "644"],
        input=json.dumps(value, indent=2) + "\n",
        text=True,
        check=True,
    )


def write_status(overrides: dict[str, str] | None = None) -> None:
    status = {name: state for name, state in REGISTRY.items()}
    try:
        previous = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if isinstance(previous, dict):
            status.update({name: str(value) for name, value in previous.items() if name in REGISTRY})
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        pass
    status.update(overrides or {})
    write_json(STATE_FILE, status)


def unsupported(name: str) -> int:
    write_status({name: "unsupported"})
    print(f"hyprchroma-electron: {name} is unsupported; no files changed")
    return 0


def vscode() -> int:
    path = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "Code/User/settings.json"
    if not path.exists():
        write_status({"vscode": "unavailable"})
        print(f"hyprchroma-electron: VS Code settings are unavailable: {path}")
        return 0
    if path.is_symlink():
        print(f"hyprchroma-electron: refusing store-linked VS Code settings: {path}", file=sys.stderr)
        write_status({"vscode": "refused"})
        return 3
    try:
        settings = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        print(f"hyprchroma-electron: cannot read {path}: {error}", file=sys.stderr)
        write_status({"vscode": "unavailable"})
        return 1

    colors = palette()
    generated = {
        "editor.background": colors["background"],
        "editor.foreground": colors["foreground"],
        "editor.selectionBackground": colors["selection"],
        "editorCursor.foreground": colors["accent"],
        "editorLineNumber.foreground": colors["muted"],
        "editorLineNumber.activeForeground": colors["foreground"],
        "activityBar.background": colors["dark_background"],
        "sideBar.background": colors["dark_background"],
        "titleBar.activeBackground": colors["dark_background"],
        "statusBar.background": colors["accent"],
        "button.background": colors["accent"],
        "focusBorder": colors["accent"],
        "terminal.ansiBlack": colors["background"],
        "terminal.ansiRed": colors["red"],
        "terminal.ansiGreen": colors["green"],
        "terminal.ansiYellow": colors["yellow"],
        "terminal.ansiBlue": colors["blue"],
        "terminal.ansiMagenta": colors["magenta"],
        "terminal.ansiCyan": colors["blue"],
        "terminal.ansiWhite": colors["foreground"],
    }
    customizations = settings.setdefault("workbench.colorCustomizations", {})
    if not isinstance(customizations, dict):
        customizations = {}
    customizations.update(generated)
    settings["workbench.colorCustomizations"] = customizations
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json(path, settings)
    write_status({"vscode": "restart-required"})
    print("hyprchroma-electron: VS Code colors synchronized; reload the window if needed")
    return 0


if len(sys.argv) != 2 or sys.argv[1] not in REGISTRY:
    print("Usage: hyprchroma-electron [vscode|discord]", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(vscode() if sys.argv[1] == "vscode" else unsupported(sys.argv[1]))
